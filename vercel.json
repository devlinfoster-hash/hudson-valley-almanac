{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    { "path": "/api/nightly-rebuild", "schedule": "0 10 * * *" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "hudsonvalleyalmanac.com" }],
      "destination": "https://www.hudsonvalleyalmanac.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "hudson-valley-almanac.vercel.app" }],
      "destination": "https://www.hudsonvalleyalmanac.com/:path*",
      "statusCode": 301
    },
    { "source": "/(.+)/", "destination": "/$1", "statusCode": 301 },
    { "source": "/buy-sell-trade", "destination": "/category/buy-sell-trade", "statusCode": 301 },
    { "source": "/news/page/1", "destination": "/news", "statusCode": 301 },
    { "source": "/guidesMap", "destination": "/guides", "statusCode": 301 },
    { "source": "/contact", "destination": "/about", "statusCode": 301 },
    { "source": "/county/greene/page/3", "destination": "/county/greene/page/2", "statusCode": 301 },
    { "source": "/county/greene/page/4", "destination": "/county/greene/page/2", "statusCode": 301 },
    { "source": "/county/greene/page/5", "destination": "/county/greene/page/2", "statusCode": 301 },
    { "source": "/county/greene/page/6", "destination": "/county/greene/page/2", "statusCode": 301 },
    { "source": "/county/greene/page/7", "destination": "/county/greene/page/2", "statusCode": 301 },
    { "source": "/county/greene/page/8", "destination": "/county/greene/page/2", "statusCode": 301 },
    { "source": "/county/sullivan/bakery", "destination": "/county/sullivan/food", "statusCode": 301 },
    { "source": "/county/sullivan/dairy", "destination": "/county/sullivan/food", "statusCode": 301 },
    { "source": "/county/sullivan/eggs", "destination": "/county/sullivan/food", "statusCode": 301 },
    { "source": "/county/sullivan/farm-stands", "destination": "/county/sullivan/food", "statusCode": 301 },
    { "source": "/county/sullivan/produce", "destination": "/county/sullivan/food", "statusCode": 301 },
    { "source": "/county/sullivan/stores", "destination": "/county/sullivan", "statusCode": 301 },
    {
      "source": "/listings/:slug",
      "destination": "/listing/:slug",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/404.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/(map|saved|trip|admin)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
